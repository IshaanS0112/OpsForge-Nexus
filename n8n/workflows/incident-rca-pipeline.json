{
  "id": "opsforgeIncidentRca",
  "name": "OpsForge — Incident RCA Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "opsforge-incident",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "OpsForge Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        160,
        380
      ],
      "webhookId": "opsforge-incident",
      "notes": "The backend posts here (N8N_WEBHOOK_URL) when an incident opens or a chaos drill completes."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.event }}",
              "operation": "equal",
              "value2": "incident_opened"
            }
          ]
        }
      },
      "id": "is-incident",
      "name": "Incident or drill?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        380,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.is_cascading }}",
              "value2": false
            }
          ]
        }
      },
      "id": "is-root",
      "name": "Root incident?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        260
      ],
      "notes": "A cascading incident is filed under its root. The root's RCA covers it, so only roots are analysed."
    },
    {
      "parameters": {
        "url": "=http://backend:8000/incidents/{{ $('OpsForge Event').item.json.body.incident_id }}/cascade-tree",
        "options": {}
      },
      "id": "fetch-cascade",
      "name": "Fetch Cascade Tree",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        820,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/incidents/{{ $('OpsForge Event').item.json.body.incident_id }}/trigger-rca",
        "options": {
          "timeout": 120000
        }
      },
      "id": "trigger-rca",
      "name": "Trigger RCA Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1040,
        160
      ]
    },
    {
      "parameters": {
        "url": "=http://backend:8000/incidents/{{ $('OpsForge Event').item.json.body.incident_id }}/business-impact?refresh=true",
        "options": {}
      },
      "id": "fetch-impact",
      "name": "Fetch Business Impact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1260,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine the root incident's RCA, cascade and impact into one report.\nconst event = $('OpsForge Event').first().json.body;\nconst tree = $('Fetch Cascade Tree').first().json;\nconst rca = $('Trigger RCA Engine').first().json;\nconst impact = $('Fetch Business Impact').first().json;\nconst top = (rca.root_cause_candidates && rca.root_cause_candidates[0]) || {};\nconst children = (tree.children || []).map((c) => c.service_name);\nreturn [{ json: {\n  incident_id: event.incident_id,\n  summary: `${event.severity} on ${event.service_name}: ${top.cause || 'cause unknown'} (${top.confidence || 'n/a'})`,\n  cascade: children.length ? `dragged down: ${children.join(', ')}` : 'no cascade',\n  estimated_impact_value: impact.estimated_impact_value,\n  rca_model: rca.llm_model_used,\n  rca_report: rca,\n  business_impact: impact,\n  notified: true\n} }];"
      },
      "id": "combine",
      "name": "Combine Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        160
      ]
    },
    {
      "parameters": {},
      "id": "notify",
      "name": "Notify on-call (mock)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1700,
        80
      ],
      "notes": "Swap this NoOp for a Slack / PagerDuty / email node once credentials exist. Mocked by default."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/webhooks/n8n-callback",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ incident_id: $json.incident_id, rca_report: $json.rca_report, business_impact: $json.business_impact, notified: true }) }}",
        "options": {}
      },
      "id": "store-callback",
      "name": "Store Combined Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1700,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// A cascading incident: point on-call at the root instead of paging again.\nconst event = $('OpsForge Event').first().json.body;\nreturn [{ json: {\n  incident_id: event.incident_id,\n  summary: `${event.service_name} is cascading from root incident ${event.root_incident_id}; see the root's report`,\n  notified: false\n} }];"
      },
      "id": "cascade-note",
      "name": "Note Cascade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Chaos drill finished: route its verdict through the same (mock) notifier.\nconst e = $('OpsForge Event').first().json.body;\nreturn [{ json: {\n  summary: `Chaos drill ${e.fault_type} on ${e.service_name}: ${e.passed ? 'PASS' : 'FAIL'}`,\n  notes: e.notes,\n  experiment_id: e.experiment_id\n} }];"
      },
      "id": "drill-summary",
      "name": "Drill Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        520
      ]
    },
    {
      "parameters": {},
      "id": "notify-drill",
      "name": "Notify drill result (mock)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        820,
        520
      ]
    }
  ],
  "connections": {
    "OpsForge Event": {
      "main": [
        [
          {
            "node": "Incident or drill?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Incident or drill?": {
      "main": [
        [
          {
            "node": "Root incident?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Drill Verdict",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Root incident?": {
      "main": [
        [
          {
            "node": "Fetch Cascade Tree",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Note Cascade",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Cascade Tree": {
      "main": [
        [
          {
            "node": "Trigger RCA Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger RCA Engine": {
      "main": [
        [
          {
            "node": "Fetch Business Impact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Business Impact": {
      "main": [
        [
          {
            "node": "Combine Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine Report": {
      "main": [
        [
          {
            "node": "Notify on-call (mock)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Store Combined Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Drill Verdict": {
      "main": [
        [
          {
            "node": "Notify drill result (mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "opsforge-v3",
  "meta": {
    "description": "Incident opened -> root? cascade tree -> RCA -> business impact -> notify (mock) -> store. Cascading incidents point at their root; chaos drill verdicts go through the same mock notifier."
  }
}
