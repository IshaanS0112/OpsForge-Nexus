# For running the backend outside Docker: copy to backend/.env and fill in.
# (docker compose does not read this file; it takes LLM_API_KEY, LLM_MODEL and
# N8N_WEBHOOK_URL from the environment or a .env next to docker-compose.yml.)
# All values have safe defaults in config.py.
# SQLite needs no server; for the compose Postgres from the host use
# postgresql://opsforge:opsforge@localhost:5432/opsforge
DATABASE_URL=sqlite:///opsforge.db

# Optional — without a key the RCA engine uses its rule-based fallback.
LLM_API_KEY=
LLM_MODEL=
# low | medium | high | xhigh | max
LLM_EFFORT=high

# Business impact parameter (mock default). In prod this comes from finance.
REVENUE_PER_REQUEST=0.50
