# Copy to .env and fill in. All values have safe defaults in config.py.
DATABASE_URL=postgresql://opsforge:opsforge@postgres:5432/opsforge

# Optional — without a key the RCA engine uses its rule-based fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Business impact parameter (mock default). In prod this comes from finance.
REVENUE_PER_REQUEST=0.50
